+func TestServer_ProcessStreamingResponse_ClientDecodeRate(t *testing.T) {
+	body := []byte("data: {\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":100,\"total_tokens\":110}}\n\n")
+	start := time.Now().Add(-4 * time.Second)
+	firstWrite := time.Now().Add(-2 * time.Second)
+	entry, err := processStreamingResponse("m", start, firstWrite, body)
+	if err != nil {
+		t.Fatalf("processStreamingResponse: %v", err)
+	}
+	// 100 tokens over the ~2s window between the first write and the end.
+	if got := entry.Tokens.TokensPerSecond; got < 45 || got > 55 {
+		t.Fatalf("TokensPerSecond = %v, want ~50", got)
+	}
+}
+
+func TestServer_ProcessStreamingResponse_NoFirstWriteKeepsUnknown(t *testing.T) {
+	body := []byte("data: {\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":100,\"total_tokens\":110}}\n\n")
+	entry, err := processStreamingResponse("m", time.Now(), time.Time{}, body)
+	if err != nil {
+		t.Fatalf("processStreamingResponse: %v", err)
+	}
+	if entry.Tokens.TokensPerSecond != -1 {
+		t.Fatalf("TokensPerSecond = %v, want -1 without a first write", entry.Tokens.TokensPerSecond)
+	}
+}
