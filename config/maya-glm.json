    "/data/huggingface-downloads/GLM-5.3-Flash-GGUF/UD-Q3_K_XL/pack",
    "--max-context",
    "1048576",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--kv-streaming",
