# 复制为 local.env 并填入密钥：
#   cp local.env.example local.env && chmod 600 local.env
# local.env 已被 .gitignore 忽略，不会进入仓库。
# 机器名默认取 hostname -s，可用 MACHINE_NAME=... 临时覆盖。
MACHINE_NAME="${MACHINE_NAME:-$(hostname -s)}"

# ---- 全局端口表（所有机器一致；端口即机器）----
T14P_LLAMA_SWAP_PORT=8080
T14P_OPENCHAMBER_PORT=3000

T450_LLAMA_SWAP_PORT=8081
T450_OPENCHAMBER_PORT=3001

HHF_LLAMA_SWAP_PORT=8082
HHF_OPENCHAMBER_PORT=3002

# ---- 本机端口 ----
case "$MACHINE_NAME" in
    arch-T14p|T14P|t14p)
        LLAMA_SWAP_PORT="$T14P_LLAMA_SWAP_PORT"
        OPENCHAMBER_PORT="$T14P_OPENCHAMBER_PORT"
        ;;
    arch-T450|T450|t450)
        LLAMA_SWAP_PORT="$T450_LLAMA_SWAP_PORT"
        OPENCHAMBER_PORT="$T450_OPENCHAMBER_PORT"
        ;;
    HonghuFusion|HHF)
        LLAMA_SWAP_PORT="$HHF_LLAMA_SWAP_PORT"
        OPENCHAMBER_PORT="$HHF_OPENCHAMBER_PORT"
        ;;
    *)
        echo "local.env: 未知机器 '$MACHINE_NAME'（用 MACHINE_NAME=... 覆盖）" >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

# ---- 全部只监听本机，跨机走同号 SSH 隧道 ----
LLAMA_SWAP_BIND=127.0.0.1
OPENCHAMBER_BIND=127.0.0.1

# ---- 密钥（各机器都需要）----
# 生成新 key:
# tip, one liner: printf "sk-%s\n" "$(head -c 48 /dev/urandom | base64 )"
HHF_API_KEY_1='sk-'
HHF_API_KEY_2='sk-'
T14P_API_KEY_1='sk-'
T14P_API_KEY_2='sk-'
