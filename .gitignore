# 下载文件
download/*

# 二进制命令, 如 llama-swap / openchamber
bin/

# openchamber 安装/运行目录（scripts/openchamber-install.sh）
openchamber/

# 日志
logs/

# llama-swap 活动数据库（含请求明细，隐私数据，不入库）
activities/

# 测试数据（图片 / 网页大文件，不入库）
test-results/

# 本机配置与密钥（llama-swap-start.sh / openchamber-start.sh 自动 source）
local.env
local.env.bak*

# pixi environments
.pixi/*
!.pixi/config.toml

# strata 量化 pack（由源 GGUF 生成，见 docs/strata.md / scripts/strata-src.sh）
strata-packs/
